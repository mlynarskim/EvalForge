{
  "name": "Customer support tickets",
  "description": "Twenty demonstration cases for structured ticket classification.",
  "test_cases": [
    {"name":"Late delivery","inputs":{"input_text":"My parcel is five days late."},"expected_output":{"category":"complaint","priority":"high","summary":"Parcel is late.","requires_human":true},"expected_keywords":["complaint","high"],"difficulty":"medium"},
    {"name":"Invoice question","inputs":{"input_text":"Where can I download my invoice?"},"expected_output":{"category":"question","priority":"low","summary":"Customer needs an invoice.","requires_human":false},"expected_keywords":["question","low"],"difficulty":"easy"},
    {"name":"Duplicate charge","inputs":{"input_text":"I was charged twice."},"expected_output":{"category":"refund","priority":"high","summary":"Duplicate payment.","requires_human":true},"expected_keywords":["refund","high"],"difficulty":"medium"},
    {"name":"Application crash","inputs":{"input_text":"The app closes when I upload a PDF."},"expected_output":{"category":"technical_issue","priority":"high","summary":"Crash during PDF upload.","requires_human":true},"expected_keywords":["technical_issue","high"],"difficulty":"hard"},
    {"name":"Address change","inputs":{"input_text":"Can I change my delivery address?"},"expected_output":{"category":"question","priority":"medium","summary":"Delivery address change.","requires_human":false},"expected_keywords":["question","medium"],"difficulty":"easy"},
    {"name":"Damaged item","inputs":{"input_text":"The screen arrived cracked."},"expected_output":{"category":"complaint","priority":"high","summary":"Item arrived damaged.","requires_human":true},"expected_keywords":["complaint","high"],"difficulty":"medium"},
    {"name":"Password reset","inputs":{"input_text":"My password reset link expired."},"expected_output":{"category":"technical_issue","priority":"medium","summary":"Expired reset link.","requires_human":false},"expected_keywords":["technical_issue","medium"],"difficulty":"easy"},
    {"name":"Cancel subscription","inputs":{"input_text":"Cancel my plan at the end of the month."},"expected_output":{"category":"other","priority":"medium","summary":"Subscription cancellation.","requires_human":true},"expected_keywords":["other","medium"],"difficulty":"medium"},
    {"name":"Wrong size","inputs":{"input_text":"I got medium instead of large."},"expected_output":{"category":"complaint","priority":"medium","summary":"Wrong size delivered.","requires_human":true},"expected_keywords":["complaint","medium"],"difficulty":"easy"},
    {"name":"Refund status","inputs":{"input_text":"When will my refund arrive?"},"expected_output":{"category":"refund","priority":"medium","summary":"Refund status request.","requires_human":false},"expected_keywords":["refund","medium"],"difficulty":"easy"},
    {"name":"Feature availability","inputs":{"input_text":"Does the plan include audit history?"},"expected_output":{"category":"question","priority":"low","summary":"Plan feature question.","requires_human":false},"expected_keywords":["question","low"],"difficulty":"easy"},
    {"name":"Login failure","inputs":{"input_text":"I see error 403 when signing in."},"expected_output":{"category":"technical_issue","priority":"high","summary":"Login is blocked.","requires_human":true},"expected_keywords":["technical_issue","high"],"difficulty":"hard"},
    {"name":"Missing accessory","inputs":{"input_text":"The charger was missing."},"expected_output":{"category":"complaint","priority":"medium","summary":"Accessory was not included.","requires_human":true},"expected_keywords":["complaint","medium"],"difficulty":"easy"},
    {"name":"Trial extension","inputs":{"input_text":"Can you extend our trial?"},"expected_output":{"category":"other","priority":"low","summary":"Trial extension request.","requires_human":true},"expected_keywords":["other","low"],"difficulty":"easy"},
    {"name":"Card rejected","inputs":{"input_text":"My card is rejected at checkout."},"expected_output":{"category":"technical_issue","priority":"high","summary":"Payment card rejected.","requires_human":true},"expected_keywords":["technical_issue","high"],"difficulty":"medium"},
    {"name":"Return request","inputs":{"input_text":"I want to return an unused item."},"expected_output":{"category":"refund","priority":"medium","summary":"Product return request.","requires_human":false},"expected_keywords":["refund","medium"],"difficulty":"easy"},
    {"name":"Support hours","inputs":{"input_text":"Is support open on Sunday?"},"expected_output":{"category":"question","priority":"low","summary":"Support hours question.","requires_human":false},"expected_keywords":["question","low"],"difficulty":"easy"},
    {"name":"Delete account","inputs":{"input_text":"Delete my account and data."},"expected_output":{"category":"other","priority":"high","summary":"Data deletion request.","requires_human":true},"expected_keywords":["other","high"],"difficulty":"medium"},
    {"name":"Incorrect invoice","inputs":{"input_text":"The tax number on my invoice is wrong."},"expected_output":{"category":"complaint","priority":"medium","summary":"Invoice contains wrong tax data.","requires_human":true},"expected_keywords":["complaint","medium"],"difficulty":"medium"},
    {"name":"Export stuck","inputs":{"input_text":"CSV export never completes."},"expected_output":{"category":"technical_issue","priority":"medium","summary":"CSV export is stuck.","requires_human":false},"expected_keywords":["technical_issue","medium"],"difficulty":"medium"}
  ]
}

